[gml_api]
module GMMobileUtilsMicrophone;

[global, bind = typed_gml]
function mic_request(): unit;

// callback(status) where status is a MicPermission value.
[global, bind = typed_gml]
function mic_check(callback: func): unit;

[global, bind = typed_gml]
enum MicPermission:int32
{
    Unknown = 0,
    NotDetermined = 1,
    Denied = 2,
    Granted = 3,
}